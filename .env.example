# ── Bam Bam chat (existing) ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-openai-key-here...
WOO_URL=https://tacticoolgun.com
WOO_CONSUMER_KEY=ck_...
WOO_CONSUMER_SECRET=cs_...

# ── FastBound (bound book + e4473) ────────────────────────────────────────
# Account number is in the FastBound URL: https://cloud.fastbound.com/<ACCOUNT>/...
FASTBOUND_ACCOUNT=
# Settings → Generate API Key (full read/write — treat like a password)
FASTBOUND_API_KEY=
# Email of the FastBound user that API writes are audited as
FASTBOUND_AUDIT_USER=aidan@tacticoolgun.com
# Printed once by `python -m ffl register-webhook`
FASTBOUND_WEBHOOK_SECRET=
# Disposition type for a counter sale; must match a value from GET SmartLists/DisposeType
FASTBOUND_SALE_TYPE=Sale
# Optional: OAuth bearer token instead of the API key (FastBound issues these by email)
FASTBOUND_ACCESS_TOKEN=

# ── Clover (register) ─────────────────────────────────────────────────────
CLOVER_MERCHANT_ID=
# Either a token from Clover dashboard → Account & Setup → API Tokens (if your dashboard offers it)
# or leave empty and complete the OAuth flow (CLOVER_APP_ID/SECRET + `python -m ffl clover-auth-url`)
CLOVER_ACCESS_TOKEN=
CLOVER_APP_ID=
CLOVER_APP_SECRET=
CLOVER_REFRESH_TOKEN=
# "Clover Auth Code" shown in the developer dashboard's Webhooks section (optional, enables header check)
CLOVER_WEBHOOK_AUTH=
CLOVER_FIREARMS_CATEGORY=Firearms
# Sandbox: CLOVER_BASE=https://apisandbox.dev.clover.com
CLOVER_BASE=https://api.clover.com

# ── Glue ──────────────────────────────────────────────────────────────────
# Public URL of this app (Railway) — needed for webhooks + the Clover OAuth callback
FFL_PUBLIC_URL=https://tacticool-ai.up.railway.app
# Long random string. Protects /ffl/status and exposes the MCP server at /mcp/<secret>
FFL_MCP_SECRET=
# SQLite file for the sync state. On Railway mount a volume and point this at it.
FFL_DB_PATH=/data/ffl.sqlite3
# How often to pull Clover orders (seconds). 0 = only webhooks / manual sync.
FFL_POLL_SECONDS=60
# Hide a Clover item once FastBound records the transfer (true) or just zero its stock (false)
FFL_HIDE_SOLD_ITEMS=true
